{
  "name": "kaletube-extension",
  "version": "1.0.0",
  "description": "Filter YouTube content to focus on educational and self-development videos",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && npm run copy-public",
    "copy-public": "cp -r public/* dist/",
    "preview": "vite preview",
    "lint": "oxlint --quiet .",
    "lint:fix": "oxlint --quiet --fix ."
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@types/chrome": "^0.1.32",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
